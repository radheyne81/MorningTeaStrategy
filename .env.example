# Indian Broker API Credentials (Fill in whichever broker you use)
# 1. Angel One SmartAPI (100% Free API: https://smartapi.angelbroking.com/)
ANGEL_API_KEY="your_smartapi_key"
ANGEL_CLIENT_CODE="your_angel_client_code"
ANGEL_PIN="your_4_digit_pin"
ANGEL_TOTP_SECRET="your_totp_base32_secret"

# 2. DhanHQ v2 API (Free Data & Order API: https://dhanhq.co/docs/v2/)
DHAN_CLIENT_ID="your_dhan_client_id"
DHAN_ACCESS_TOKEN="your_dhan_jwt_access_token"

# 3. Zerodha Kite Connect v3 (https://kite.trade/docs/connect/v3/)
KITE_API_KEY="your_kite_api_key"
KITE_ACCESS_TOKEN="your_kite_access_token"

# 4. Upstox Open API (https://upstox.com/developer/api-documentation/open-api)
UPSTOX_ACCESS_TOKEN="your_upstox_access_token"
